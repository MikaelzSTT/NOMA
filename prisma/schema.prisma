generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AvailabilityStatus {
  AVAILABLE
  OUT_OF_STOCK
  PREORDER
  UNKNOWN
  REMOVED
}

enum Market {
  BR
  US
}

enum ProductSyncStatus {
  PENDING
  SYNCED
  STALE
  ERROR
}

enum PricingRuleType {
  FIXED_MARGIN
  MARKUP
}

enum ImageStorageStatus {
  EXTERNAL
  PENDING_COPY
  STORED
  COPY_ERROR
}

enum ImportType {
  API
  CSV
  XLSX
  URL
  URL_BATCH
}

enum ImportStatus {
  PENDING
  IMPORTING
  PREVIEW
  SUCCESS
  ERROR
  CANCELLED
}

enum SyncOperation {
  FULL_CATALOG
  INCREMENTAL
  CATEGORY
  SEARCH
  PRICE
  AVAILABILITY
  MANUAL
}

enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/// A fonte comercial do produto. O nome fisico da tabela e mantido para que
/// instalacoes da versao anterior possam migrar sem copiar dados.
model Supplier {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  adapterKey           String    @unique @map("providerKey")
  baseUrl              String?
  active               Boolean   @default(true)
  authorized           Boolean   @default(false)
  settings             Json?
  credentialsEncrypted String?
  capabilities         String[]  @default([])
  supportedMarkets     Market[]  @default([BR])
  syncCursor           String?
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  products         Product[]
  offers           ProductMarketOffer[]
  pricingRules     PricingRule[]
  mappingTemplates ImportMappingTemplate[]
  importJobs       ImportJob[]

  @@index([active])
  @@map("Store")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]    @relation("CategoryTree")
  products     Product[]
  pricingRules PricingRule[]

  @@index([parentId])
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id                  String             @id @default(cuid())
  supplierProductId   String             @map("externalId")
  supplierName        String
  sku                 String
  canonicalHash       String?
  slug                String             @unique
  title               String             @map("name")
  shortDescription    String?
  description         String?            @map("fullDescription")
  subcategory         String?
  costPrice           Decimal?           @db.Decimal(12, 2)
  sellingPrice        Decimal?           @map("currentPrice") @db.Decimal(12, 2)
  compareAtPrice      Decimal?           @map("previousPrice") @db.Decimal(12, 2)
  discountPercent     Decimal?           @db.Decimal(5, 2)
  currency            String             @default("BRL") @db.VarChar(3)
  stock               Int                @default(0)
  availability        AvailabilityStatus @default(UNKNOWN)
  shippingCost        Decimal?           @db.Decimal(12, 2)
  estimatedDelivery   String?
  sourceUrl           String?            @map("originalUrl")
  attributes          Json?              @map("specifications")
  source              String
  active              Boolean            @default(true)
  featured            Boolean            @default(false)
  archivedAt          DateTime?
  manualPriceOverride Boolean            @default(false)
  pricingRuleType     PricingRuleType?
  pricingRuleValue    Decimal?           @db.Decimal(12, 4)
  rating              Decimal?           @db.Decimal(3, 2)
  reviewCount         Int?
  installmentText     String?
  popularityScore     Int                @default(0)
  internalNotes       String?
  syncStatus          ProductSyncStatus  @default(PENDING)
  syncError           String?
  syncErrorAt         DateTime?
  lastPriceSyncAt     DateTime?
  lastStockSyncAt     DateTime?
  lastSyncedAt        DateTime
  firstSeenAt         DateTime           @default(now())
  removedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  supplierId          String             @map("storeId")
  categoryId          String
  brandId             String?

  supplier     Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand        Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  variants     ProductVariant[]
  offers       ProductMarketOffer[]
  priceHistory PriceHistory[]
  importItems  ImportItem[]

  @@unique([supplierId, supplierProductId])
  @@index([active, archivedAt, availability])
  @@index([categoryId, active, sellingPrice])
  @@index([brandId, active])
  @@index([supplierId, active])
  @@index([sellingPrice])
  @@index([discountPercent])
  @@index([lastPriceSyncAt])
  @@index([lastStockSyncAt])
  @@index([createdAt])
  @@index([canonicalHash])
  @@index([title])
  @@index([sku])
}

model ProductMarketOffer {
  id                       String             @id @default(cuid())
  productId                String
  market                   Market
  supplierId               String
  supplierProductId        String
  sku                      String
  title                    String?
  slug                     String
  shortDescription         String?
  description              String?
  images                   Json?
  seoTitle                 String?
  seoDescription           String?
  currency                 String             @default("BRL") @db.VarChar(3)
  costPrice                Decimal?           @db.Decimal(12, 2)
  sellingPrice             Decimal?           @db.Decimal(12, 2)
  compareAtPrice           Decimal?           @db.Decimal(12, 2)
  discountPercent          Decimal?           @db.Decimal(5, 2)
  stockQuantity            Int                @default(0)
  availability             AvailabilityStatus @default(UNKNOWN)
  shippingCost             Decimal?           @db.Decimal(12, 2)
  estimatedDelivery        String?
  estimatedDeliveryMinDays Int?
  estimatedDeliveryMaxDays Int?
  sourceUrl                String?
  active                   Boolean            @default(true)
  featured                 Boolean            @default(false)
  popularityScore          Int                @default(0)
  manualPriceOverride      Boolean            @default(false)
  pricingRuleType          PricingRuleType?
  pricingRuleValue         Decimal?           @db.Decimal(12, 4)
  internalNotes            String?
  syncStatus               ProductSyncStatus  @default(PENDING)
  syncError                String?
  syncErrorAt              DateTime?
  lastPriceSyncAt          DateTime?
  lastStockSyncAt          DateTime?
  lastSyncedAt             DateTime
  firstSeenAt              DateTime           @default(now())
  removedAt                DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  variants ProductMarketOfferVariant[]

  @@unique([market, slug])
  @@unique([supplierId, market, supplierProductId])
  @@index([productId, market])
  @@index([market, active, availability])
  @@index([market, active, sellingPrice])
  @@index([supplierId, market, active])
  @@index([featured, popularityScore])
  @@index([lastPriceSyncAt])
  @@index([lastStockSyncAt])
}

model ProductMarketOfferVariant {
  id             String             @id @default(cuid())
  label          String
  sku            String?
  attributes     Json
  costPrice      Decimal            @db.Decimal(12, 2)
  salePrice      Decimal            @db.Decimal(12, 2)
  compareAtPrice Decimal?           @db.Decimal(12, 2)
  stock          Int                @default(0)
  active         Boolean            @default(true)
  availability   AvailabilityStatus @default(UNKNOWN)
  sourceUrl      String?
  imageUrl       String?
  isDefault      Boolean            @default(false)
  position       Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  offerId        String

  offer ProductMarketOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, active])
  @@index([offerId, isDefault])
  @@index([sku])
}

model ProductVariant {
  id                String   @id @default(cuid())
  supplierVariantId String?
  sku               String
  title             String
  options           Json
  costPrice         Decimal? @db.Decimal(12, 2)
  sellingPrice      Decimal? @db.Decimal(12, 2)
  stock             Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  productId         String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sku])
  @@index([productId, active])
}

model ProductImage {
  id            String             @id @default(cuid())
  url           String
  sourceUrl     String?
  storageKey    String?
  storageStatus ImageStorageStatus @default(EXTERNAL)
  alt           String?
  position      Int                @default(0)
  isPrimary     Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  productId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@index([productId, position])
  @@index([storageStatus])
}

model PriceHistory {
  id             String   @id @default(cuid())
  sellingPrice   Decimal  @map("price") @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("previousPrice") @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)
  currency       String   @default("BRL") @db.VarChar(3)
  market         Market   @default(BR)
  recordedAt     DateTime @default(now())
  productId      String
  productOfferId String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
  @@index([productOfferId, recordedAt])
}

model PricingRule {
  id                String          @id @default(cuid())
  name              String
  type              PricingRuleType
  value             Decimal         @db.Decimal(12, 4)
  roundingIncrement Decimal?        @db.Decimal(12, 2)
  active            Boolean         @default(true)
  priority          Int             @default(0)
  supplierId        String?
  categoryId        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([supplierId, active, priority])
  @@index([categoryId, active, priority])
}

model ImportMappingTemplate {
  id            String     @id @default(cuid())
  name          String
  fileType      ImportType
  columnMapping Json
  defaults      Json?
  supplierId    String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  supplier Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  jobs     ImportJob[]

  @@unique([supplierId, name])
  @@index([supplierId, updatedAt])
}

model ImportJob {
  id                String       @id @default(cuid())
  type              ImportType
  status            ImportStatus @default(PENDING)
  sourceName        String?
  columnMapping     Json?
  totalItems        Int          @default(0)
  processedItems    Int          @default(0)
  successItems      Int          @default(0)
  errorItems        Int          @default(0)
  message           String?
  supplierId        String?
  market            Market       @default(BR)
  mappingTemplateId String?
  createdAt         DateTime     @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  updatedAt         DateTime     @updatedAt

  supplier        Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  mappingTemplate ImportMappingTemplate? @relation(fields: [mappingTemplateId], references: [id], onDelete: SetNull)
  items           ImportItem[]

  @@index([status, createdAt])
  @@index([supplierId, createdAt])
}

model ImportItem {
  id             String       @id @default(cuid())
  sourceRef      String?
  status         ImportStatus @default(PENDING)
  rawData        Json?
  normalizedData Json?
  error          String?
  attempts       Int          @default(0)
  jobId          String
  productId      String?
  createdAt      DateTime     @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  updatedAt      DateTime     @updatedAt

  job     ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([jobId, status])
  @@index([productId])
}

model SyncLog {
  id             String        @id @default(cuid())
  provider       String
  operation      SyncOperation
  status         SyncStatus    @default(RUNNING)
  processedCount Int           @default(0)
  successCount   Int           @default(0)
  errorCount     Int           @default(0)
  skippedCount   Int           @default(0)
  durationMs     Int?
  message        String?
  errorSummary   Json?
  cursor         String?
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?

  @@index([provider, startedAt])
  @@index([status, startedAt])
}

model SyncLock {
  provider      String   @id
  ownerId       String
  acquiredUntil DateTime
  updatedAt     DateTime @updatedAt

  @@index([acquiredUntil])
}

# Banco local (docker-compose.yml)
DATABASE_URL="postgresql://vitrineo:vitrineo@localhost:5432/vitrineo?schema=public"

# URL publica usada em canonical, sitemap e callbacks
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Modo temporario para campanhas de trafego: "true" liga, qualquer outro valor desliga.
PUBLIC_MAINTENANCE_MODE="false"

# Tracking publico. IDs reais devem ser configurados no ambiente, nao no codigo.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=""

# Chave com 32+ caracteres usada para criptografar tokens/configs de fornecedores
# antes de persistir no banco. Nunca use prefixo NEXT_PUBLIC_ aqui.
SUPPLIER_CONFIG_ENCRYPTION_KEY=""

# Admin: gere o hash com `npm run admin:hash -- "sua-senha"`
AUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
SESSION_TTL_HOURS="8"

# Protege /api/cron/sync (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# Agendamento e limites. O agendador externo chama /api/cron/sync.
SYNC_PRICE_CRON="0 */6 * * *"
SYNC_AVAILABILITY_CRON="30 */6 * * *"
SYNC_CATALOG_CRON="0 3 * * *"
SYNC_BATCH_SIZE="100"
SYNC_REQUESTS_PER_SECOND="2"
SYNC_MAX_RETRIES="3"
SYNC_STALE_HOURS="24"

# Limites por processo. Em múltiplas instâncias, substitua por Redis/KV.
PUBLIC_RATE_LIMIT_PER_MINUTE="60"
ADMIN_RATE_LIMIT_PER_MINUTE="20"
